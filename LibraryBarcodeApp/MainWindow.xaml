<Window x:Class="LibraryBarcodeApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Library Barcode App"
        Height="640"
        Width="1180"
        MinHeight="560"
        MinWidth="980"
        Background="#EEF2F8">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3D63DD" />
        <SolidColorBrush x:Key="PanelBrush" Color="#1F2A44" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A3657" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#3D4A70" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderBrush" Value="#CDD5E5" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="RowBackground" Value="#FFFFFF" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFF" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="BorderBrush" Value="#D7DEED" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource PanelBrush}"
                CornerRadius="12"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Library Barcode"
                               Foreground="White"
                               FontSize="19"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Управление библиотекой"
                               Margin="0,4,0,0"
                               Foreground="#B5C2E5"
                               FontSize="12" />
                </StackPanel>

                <Border Grid.Row="1"
                        Background="#2A3657"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,0,0,14">
                    <TextBlock Text="{Binding UserStatusText}"
                               Foreground="#E2EAFF"
                               TextWrapping="Wrap"
                               FontSize="12" />
                </Border>

                <StackPanel Grid.Row="2">
                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="Мой профиль"
                            Click="OpenMyProfile_Click" />
                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="Отчеты"
                            Click="OpenReports_Click" />
                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="О программе"
                            Click="OpenAbout_Click" />
                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="Пользователи"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                            Click="OpenUsers_Click" />
                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="Журнал попыток входа"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                            Click="OpenLoginAttempts_Click" />
                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="Статистика админа"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                            Click="OpenAdminStatistics_Click" />
                </StackPanel>

                <Button Grid.Row="3"
                        Style="{StaticResource NavButtonStyle}"
                        Margin="0"
                        Content="Выйти из аккаунта"
                        Click="Logout_Click" />
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="12"
                BorderBrush="#D7DEED"
                BorderThickness="1"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Каталог книг"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#1D2942" />
                        <TextBlock Text="Быстрый поиск, выдача и контроль статусов"
                                   Margin="0,4,0,0"
                                   Foreground="#6A748B" />
                    </StackPanel>
                    <TextBox Grid.Column="1"
                             Height="36"
                             VerticalContentAlignment="Center"
                             ToolTip="Поиск по названию, автору или штрихкоду"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Border Grid.Row="1"
                        Background="#F5F7FD"
                        BorderBrush="#DCE3F1"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,0,0,10">
                    <TextBlock Text="{Binding StatisticsText}"
                               Foreground="#2A3553"
                               FontSize="13"
                               FontWeight="SemiBold" />
                </Border>

                <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                    <Button Style="{StaticResource ActionButtonStyle}" Width="136" Height="34" Content="Добавить книгу" Click="AddBook_Click" />
                    <Button Style="{StaticResource ActionButtonStyle}" Width="98" Height="34" Content="Выдать" Click="Borrow_Click" />
                    <Button Style="{StaticResource ActionButtonStyle}" Width="98" Height="34" Content="Вернуть" Click="Return_Click" />
                    <Button Style="{StaticResource ActionButtonStyle}" Width="106" Height="34" Content="Обновить" Command="{Binding RefreshCommand}" />
                    <Button Style="{StaticResource ActionButtonStyle}" Width="140" Height="34" Content="Удалить книгу" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" Click="DeleteBook_Click" />
                    <Button Style="{StaticResource ActionButtonStyle}" Width="160" Height="34" Content="Редактировать книгу" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" Click="EditBook_Click" />
                    <Button Style="{StaticResource ActionButtonStyle}" Width="110" Height="34" Content="Утеряна" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" Click="MarkLost_Click" />
                </WrapPanel>

                <DataGrid Grid.Row="3"
                          Margin="0,0,0,10"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding BooksView}"
                          SelectedItem="{Binding SelectedBook, Mode=TwoWay}">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Редактировать книгу"
                                      Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                                      Click="EditBook_Click" />
                            <MenuItem Header="Удалить книгу"
                                      Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                                      Click="DeleteBook_Click" />
                            <Separator Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" />
                            <MenuItem Header="Изменить статус на 'Утеряна'"
                                      Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                                      Click="MarkLost_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Штрихкод" Binding="{Binding Barcode}" Width="1.2*" />
                        <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*" />
                        <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="1.5*" />
                        <DataGridTextColumn Header="Год" Binding="{Binding Year}" Width="0.8*" />
                        <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="1.2*" />
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="1*" />
                    </DataGrid.Columns>
                </DataGrid>

                <StatusBar Grid.Row="4"
                           Background="#F7F9FD"
                           BorderBrush="#DCE3F1"
                           BorderThickness="1">
                    <StatusBarItem>
                        <TextBlock Text="{Binding StatusMessage}" />
                    </StatusBarItem>
                </StatusBar>
            </Grid>
        </Border>
    </Grid>
</Window>
