<Window x:Class="LibraryBarcodeApp.ScanSourceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сканирование штрихкода"
        Height="220"
        Width="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#EEF2F8">

    <Window.Resources>
        <Style x:Key="ScanButton" TargetType="Button">
            <Setter Property="Height" Value="60" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="Выберите способ сканирования"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#1D2942"
                   Margin="0,0,0,16" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{StaticResource ScanButton}"
                    Background="#3D63DD"
                    Foreground="White"
                    BorderBrush="#2D53CD"
                    Content="📷  Камера"
                    Click="Camera_Click" />

            <Button Grid.Column="2"
                    Style="{StaticResource ScanButton}"
                    Background="White"
                    Foreground="#3D63DD"
                    BorderBrush="#C0CCEE"
                    Content="🖼  Изображение"
                    Click="Image_Click" />
        </Grid>

        <Button Height="32"
                Margin="0,12,0,0"
                Background="Transparent"
                Foreground="#6A748B"
                BorderBrush="#D5DDEE"
                BorderThickness="1"
                Cursor="Hand"
                Content="Отмена"
                Click="Cancel_Click" />
    </StackPanel>
</Window>
