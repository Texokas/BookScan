<Window x:Class="LibraryBarcodeApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход"
        Height="720"
        Width="980"
        MinHeight="680"
        MinWidth="900"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F8">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#3D63DD" />
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderBrush" Value="#CBD4E5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="38" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderBrush" Value="#CBD4E5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="38" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="1.2*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Margin="0,0,16,0"
                Background="#1F2A44"
                CornerRadius="14"
                Padding="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Library Barcode"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White" />

                <TextBlock Grid.Row="1"
                           Margin="0,10,0,0"
                           Text="Система учета и контроля библиотечного фонда"
                           Foreground="#C6D3F5"
                           FontSize="14"
                           TextWrapping="Wrap" />

                <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                    <TextBlock Foreground="#E3EBFF" FontSize="16" FontWeight="SemiBold" Text="Возможности" />
                    <TextBlock Margin="0,10,0,0" Foreground="#C6D3F5" Text="• Быстрый поиск по каталогу" />
                    <TextBlock Margin="0,6,0,0" Foreground="#C6D3F5" Text="• Выдача и возврат по штрихкоду" />
                    <TextBlock Margin="0,6,0,0" Foreground="#C6D3F5" Text="• Администрирование пользователей" />
                    <TextBlock Margin="0,6,0,0" Foreground="#C6D3F5" Text="• Отчеты и статистика" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="White"
                CornerRadius="14"
                BorderBrush="#D5DDEE"
                BorderThickness="1"
                Padding="26">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Вход в систему"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#1D2942" />

                <TextBlock Grid.Row="1"
                           Margin="0,6,0,16"
                           Text="Введите данные учетной записи"
                           Foreground="#6A748B" />

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Email" FontWeight="SemiBold" Foreground="#29344F" />
                    <TextBox x:Name="EmailTextBox" Margin="0,6,0,12" />
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <TextBlock Text="Пароль" FontWeight="SemiBold" Foreground="#29344F" />
                    <PasswordBox x:Name="PasswordBox" Margin="0,6,0,12" />
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,0,0,14">
                    <TextBlock Text="Капча" FontWeight="SemiBold" Foreground="#29344F" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="220"
                                Height="64"
                                BorderBrush="#CBD4E5"
                                BorderThickness="1"
                                CornerRadius="6"
                                Background="#F8FAFF">
                            <Image x:Name="CaptchaImage" Stretch="Uniform" />
                        </Border>
                        <Button Grid.Column="2"
                                Height="36"
                                Width="150"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="Обновить капчу"
                                Click="RefreshCaptcha_Click" />
                    </Grid>
                    <TextBox x:Name="CaptchaInputTextBox"
                             Margin="0,10,0,0"
                             ToolTip="Введите символы с картинки" />
                </StackPanel>

                <Button Grid.Row="5"
                        Height="40"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Content="Войти"
                        Click="Login_Click" />

                <StackPanel Grid.Row="6" Margin="0,12,0,0">
                    <Label x:Name="ErrorLabel"
                           Foreground="Crimson"
                           FontSize="12"
                           Content="" />
                    <Label FontSize="12"
                           Foreground="#6A748B"
                           Content="Забыли пароль? Обратитесь к администратору" />

                    <Separator Margin="0,14,0,10" Background="#E2E8F0" />

                    <TextBlock Text="Режим тестирования"
                               FontSize="11"
                               Foreground="#9AA3B5"
                               Margin="0,0,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox x:Name="DemoAdminCheckBox"
                                  Grid.Column="0"
                                  Content="Войти как администратор"
                                  VerticalAlignment="Center"
                                  Foreground="#6A748B"
                                  FontSize="12" />

                        <Button Grid.Column="1"
                                Height="32"
                                Padding="14,0"
                                FontSize="12"
                                Content="Тестовый вход"
                                Background="#F0F4FF"
                                Foreground="#3D63DD"
                                BorderBrush="#C0CCEE"
                                BorderThickness="1"
                                Click="DemoLogin_Click" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

