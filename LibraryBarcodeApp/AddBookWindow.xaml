<Window x:Class="LibraryBarcodeApp.AddBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить книгу"
        Height="560"
        Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="2"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"
                   Text="Новая книга" />

        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Штрихкод:" />
        <TextBox Grid.Row="1"
                 Grid.Column="1"
                 Height="30"
                 Margin="0,0,0,10"
                 VerticalContentAlignment="Center"
                 Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" />

        <Button Grid.Row="2"
                Grid.Column="1"
                Width="260"
                Height="32"
                HorizontalAlignment="Left"
                Margin="0,0,0,10"
                Content="Загрузить изображение штрихкода"
                Click="LoadBarcodeImage_Click" />

        <Border Grid.Row="3"
                Grid.ColumnSpan="2"
                Height="160"
                Margin="0,0,0,10"
                BorderThickness="1"
                BorderBrush="#D0D0D0"
                Background="#FAFAFA">
            <Image Source="{Binding BarcodeImagePreview}"
                   Stretch="Uniform" />
        </Border>

        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Название:" />
        <TextBox Grid.Row="4"
                 Grid.Column="1"
                 Height="30"
                 Margin="0,0,0,10"
                 VerticalContentAlignment="Center"
                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Text="Автор:" />
        <TextBox Grid.Row="5"
                 Grid.Column="1"
                 Height="30"
                 Margin="0,0,0,10"
                 VerticalContentAlignment="Center"
                 Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" />

        <Grid Grid.Row="6" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Год:" />
            <TextBox Grid.Column="1"
                     Height="30"
                     VerticalContentAlignment="Center"
                     Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="Категория:" />
            <ComboBox Grid.Column="4"
                      Height="30"
                      ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Grid Grid.Row="7" Grid.ColumnSpan="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="DimGray"
                       Text="{Binding StatusMessage}" />

            <Button Grid.Column="1"
                    Width="110"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="Сохранить"
                    Click="Save_Click" />

            <Button Grid.Column="2"
                    Width="100"
                    Height="32"
                    Content="Отмена"
                    IsCancel="True" />
        </Grid>
    </Grid>
</Window>
